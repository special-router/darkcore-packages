#!/bin/sh /etc/rc.common

# Регистрация идёт после сети: без неё запрос всё равно не уйдёт.
START=99
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/darkcore-provision
	# Одноразовая по смыслу: при заполненном uuid скрипт сразу выходит нулём.
	# respawn нужен на случай, когда сеть поднялась позже самого сервиса.
	procd_set_param respawn 60 30 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
